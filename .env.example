# Optional environment for this project. Copy to .env and fill in values.
# Never commit real secrets.

# Stripe Payment Link for donations (recurring $9 link from the Stripe dashboard).
VITE_STRIPE_PRO_PAYMENT_LINK=

# Stripe Payment Link for the one-time $49 audit plan.
VITE_STRIPE_AUDIT_PAYMENT_LINK=

# --- GitHub App (reposell) ---
# The CLI ships with the public reposell client ID, so these are only needed to
# run your own GitHub App. Device flow needs NO client secret (public client).
#   - Permissions: Contents Read and write, Pull requests Read and write,
#     Workflows Read and write, Metadata Read.
#   - Enable Device Flow (Issuing user authorization tokens -> device flow).
#   - The user installs the app on any repo they want Repo Shield to PR into.
GITHUB_CLIENT_ID=
GITHUB_APP_SLUG=reposell
# Never required for device flow. Leave empty.
GITHUB_CLIENT_SECRET=